{
  "manifest_version": 3,
  "name": "Zoom Transcript Downloader",
  "version": "1.5.4",
  "description": "Downloads Zoom transcripts and generates rename scripts for macOS or Windows.",
  "permissions": [
    "downloads",
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://*.zoom.us/*",
    "https://zoom.us/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "page-hook.js"
      ],
      "matches": [
        "https://*.zoom.us/*",
        "https://zoom.us/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://zoom.us/recording/meeting/transcript*",
        "https://*.zoom.us/recording/meeting/transcript*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Zoom Transcript Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
